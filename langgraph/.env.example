# LangGraph / DeepSeek 配置
# 复制为 .env 后按需填写；DEEPSEEK_API_KEY 为空时生成节点会降级（不真正调用 LLM）

# DeepSeek（OpenAI 兼容接口）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# LangSmith（可选，用于链路追踪/调试）
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=fastapi-app-langgraph
