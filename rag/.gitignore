# ── 密钥（绝不提交）──
.env

# ── 虚拟环境 / 依赖产物 ──
.venv/
__pycache__/
*.pyc
.pytest_cache/

# ── 运行数据（Qdrant 索引 / 解析缓存 / PDF 测试文档不入库，md 保留）──
qdrant_data/
data/_parse_cache/
data/docs/**/*.pdf
data/docs/*.pdf
!data/docs/*.md
# 前端上传的文档（FastAPI ingest 接口落盘目录）
data/uploads/

# ── 构建产物 ──
dist/
build/

# ── OS / IDE ──
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp