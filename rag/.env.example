# DeepSeek（OpenAI 兼容。必填）
DEEPSEEK_API_KEY=sk-xxxxxxxx
# 可选：换其他 OpenAI 兼容端点
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# HuggingFace 镜像（国内必填，代码 config.py 已默认 hf-mirror.com，可覆盖）
# fastembed 首次会自动下载 bge-small-zh-v1.5 模型（约 150MB），直连 HF 常超时
# HF_ENDPOINT=https://hf-mirror.com
# 禁用 xet 存储后端（国内 cas-server.xethub.hf.co 401），强制走普通 HTTP 镜像下载
# HF_HUB_DISABLE_XET=1

# MinerU 官方云 API（包名 mineru-open-sdk）：留空 = Flash 免费模式（免 token，云端解析，够试用）
# 填 token = 标准模式（https://mineru.net 免费申请，精度更高/不排队）
# MINERU_TOKEN=

# 可选：硅基流动 rerank（开 bge-reranker-v2-m3 时填）
# SILICONFLOW_API_KEY=

# ── Qdrant 存储模式（默认 local 免 Docker，可不配）─────────────────
# 生产/并发场景：配 QDRANT_URL 切远端 server（支持多进程；local 同一目录只允许一个进程）
#   例：QDRANT_URL=http://localhost:6333  或   https://xxxx.cloud.qdrant.io
# 云端/Qdrant Cloud 需鉴权时填 QDRANT_API_KEY
# QDRANT_URL=
# QDRANT_API_KEY=
# 可选量化（内存优化，仅对新建集合生效，需 delete_collection 重建后重新 ingest）：
#   int8 = 标量量化，内存省 ~3/4，召回精度略降；留空 = 不量化
# QDRANT_QUANTIZATION=

# 检索调优（chunk_size 是段落聚合目标，不是硬切长度）
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=0
# RAG_CANDIDATE_MULTIPLIER=4
# RAG_RRF_K=60
# BM25 参数
# RAG_BM25_K1=1.2
# RAG_BM25_B=0.75
# rerank 结果低于该分数时过滤；0 = 不过滤
# RERANK_SCORE_THRESHOLD=0
