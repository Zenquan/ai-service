{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "AI 智能客服任务评测指标面板：一次解决率 / 转人工率 / 工具成功率 / 无依据承诺率 / 响应时延。",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "客服任务质量总览",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "一次解决率",
      "description": "未转人工、未追问、无错误的请求占比",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(cs_eval_resolved_total[$__rate_interval])) / clamp_min(sum(rate(cs_eval_requests_total[$__rate_interval])), 1)",
          "legendFormat": "一次解决率",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 }
    },
    {
      "type": "stat",
      "title": "转人工率",
      "description": "转人工请求占比（越低越好）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 0.5 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(cs_eval_human_handoff_total[$__rate_interval])) / clamp_min(sum(rate(cs_eval_requests_total[$__rate_interval])), 1)",
          "legendFormat": "转人工率",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 }
    },
    {
      "type": "stat",
      "title": "工具成功率",
      "description": "工具调用 ok 占全部工具调用的比例",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "green", "value": 0.95 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(cs_eval_tool_calls_total{tool_status=\"ok\"}[$__rate_interval])) / clamp_min(sum(rate(cs_eval_tool_calls_total[$__rate_interval])), 1)",
          "legendFormat": "工具成功率",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 }
    },
    {
      "type": "stat",
      "title": "无依据承诺率",
      "description": "引用校验失败（valid=0）占比（越低越好）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.15 },
              { "color": "red", "value": 0.3 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(cs_eval_citation_valid_total{valid=\"0\"}[$__rate_interval])) / clamp_min(sum(rate(cs_eval_citation_valid_total[$__rate_interval])), 1)",
          "legendFormat": "无依据承诺率",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 }
    },
    {
      "type": "timeseries",
      "title": "响应时延 P50 / P95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(cs_eval_latency_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(cs_eval_latency_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "P95",
          "refId": "B"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 }
    },
    {
      "type": "timeseries",
      "title": "请求量（按响应模式）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "stacking": { "mode": "normal" } }
        }
      },
      "targets": [
        {
          "expr": "sum by (response_mode) (rate(cs_eval_requests_total[$__rate_interval]))",
          "legendFormat": "{{ response_mode }}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 }
    },
    {
      "type": "timeseries",
      "title": "工具调用状态分布",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "bars", "lineWidth": 1, "stacking": { "mode": "normal" } }
        }
      },
      "targets": [
        {
          "expr": "sum by (tool_status) (rate(cs_eval_tool_calls_total[$__rate_interval]))",
          "legendFormat": "{{ tool_status }}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["ai", "customer-service", "rag"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "AI 智能客服 · 任务评测",
  "uid": "ai-customer-service-eval",
  "version": 1
}
