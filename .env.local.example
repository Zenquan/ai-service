# 本地开发环境变量模板：复制为 .env.local 并填写实际值（.env.local 已被 .gitignore 忽略）
# 用途：本地后端连云端 MySQL 公网，与线上共享同一份会话/文档切块数据
MYSQL_HOST=your-cloud-mysql-host.example.com
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DB=your-database-name

# 登录认证（demo 迭代）：生产环境必须改为随机强密钥 + 外部账号体系
AUTH_JWT_SECRET=replace-with-random-secret
AUTH_TOKEN_TTL_HOURS=24
# 覆盖 demo 账号（不设置时使用代码内默认值 zenquan/zenquan123、alice/alice123）
AUTH_OPERATOR_USERNAME=zenquan
AUTH_OPERATOR_PASSWORD=your-operator-password
AUTH_CUSTOMER_USERNAME=alice
AUTH_CUSTOMER_PASSWORD=your-customer-password

# 客服任务评测（指标埋点 + 告警）
# 告警阈值（窗口滑动比率，0~1）：超过即触发告警落库 + webhook 通知
ALERT_HANDOFF_RATE=0.5        # 转人工率阈值
ALERT_ERROR_RATE=0.3          # 出错率阈值
ALERT_UNFOUNDED_RATE=0.3      # 无依据承诺率（引用校验失败）阈值
ALERT_MIN_SAMPLES=10          # 窗口样本数下限，样本不足不告警（避免小样本误报）
# 告警 webhook（可选）：触发后 POST JSON，留空则不推送
ALERT_WEBHOOK_URL=
