# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# 私有密钥（rag/.env 已有自己的 ignore，这里兜底）
.env

# 前端依赖与产物（web/.gitignore 已覆盖，这里兜底）
web/node_modules/
web/dist/

# 运行时数据（rag/.gitignore 已覆盖：qdrant_data/_parse_cache/uploads/PDF）
# 说明：rag 已并入本仓库统一管理（不再独立 git）
qdrant_data/

# FastEmbed 本地模型缓存（手动下载，不纳入版本库）
rag/data/fastembed_cache/

.reasonix/

.workbuddy/

# 本地开发环境变量（含数据库密码，不入库）
.env.local

# server 运行数据（fastembed 模型缓存/解析缓存/上传文件，不入库）
server/data/fastembed_cache/
server/data/_parse_cache/
server/data/uploads/
server/qdrant_data/
server/.venv/
server/data/docs/**/*.pdf
server/data/docs/*.pdf
!server/data/docs/*.md
